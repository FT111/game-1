---
config:
  layout: elk
---

classDiagram
direction TB

class EngineFactory {
    +withWorld(World world) EngineFactory
    +withRenderer(Renderer renderer) EngineFactory
    +withTicksPerSecond(int ticksPerSecond) EngineFactory
    +build() Engine
}

class Engine {
    +World: World
    +Renderer: Renderer
    +Systems: Systems
    +Resources: Resources
    +EventBus: EventBus
    +SceneManager: SceneManager
    +LayoutManager: LayoutManager
    +StartGameLoop() void
}

class EventBus {
    +publish(event) EventSubscriptionReceipt
    +subscribe(type, enabledPredicate, callback) EventSubscriptionReceipt
    +flush() void
}

class World
class Systems {
    +addSystem(system) void
    +removeSystem(type) void
    +update(world, tickCount) void
}
class Resources {
    +addResourceLoader(loader) void
    +getAsset(key, id, type) Object
    +setAsset(key, id, asset) void
}
class Renderer {
    +renderPasses: List<RenderPass>
    +render(world, resources) void
}
class SceneManager {
    +addScene(name, scene) SceneManager
    +switchScene(sceneName) void
    +pushScene(sceneName) void
    +popScene() void
}
class LayoutManager {
    +defineMapLayer(name) MapLayerBuilder
    +getSpatialMap(name) SpatialMap
}

class Scene {
    +systems: Set<System>
    +world: SceneWorld
}
class SceneWorld
class System {
    <<abstract>>
}
class GraphicsAPI {
    <<interface>>
}
class LanternaAPI
class RenderPass {
    <<abstract>>
}
class TileMapRenderPass
class BlockRenderPass
class EntityRenderPass
class TextRenderPass
class InputHandlerSystem
class MovementSystem
class UiInteractionSystem
class GlobalScene
class MainMenuScene
class GameplayScene

EngineFactory --> Engine

Engine *-- World
Engine *-- Renderer
Engine *-- Systems
Engine *-- Resources
Engine *-- EventBus
Engine *-- SceneManager
Engine *-- LayoutManager
Engine ..> GraphicsAPI

GraphicsAPI <|.. LanternaAPI

Renderer o-- RenderPass
RenderPass <|-- TileMapRenderPass
RenderPass <|-- BlockRenderPass
RenderPass <|-- EntityRenderPass
RenderPass <|-- TextRenderPass

SceneManager o-- Scene
Scene *-- SceneWorld
Systems o-- System
System <|-- InputHandlerSystem
System <|-- MovementSystem
System <|-- UiInteractionSystem

Scene <|-- GlobalScene
Scene <|-- MainMenuScene
Scene <|-- GameplayScene